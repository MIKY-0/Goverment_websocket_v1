<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>채팅(폴링)</title>

    <style>
        body{
            margin: 20px;
            font-family: Arial, sans-serif;
        }
        nav a{
            padding: 8px 15px;
            margin-right: 10px;
            background: #666;
            color: white;
            text-decoration: none;
        }
        .info{
            color: #666;
            font-size: 13px;
        }
        .chat-area{
            border: 1px solid #ccc;
            height: 300px;
            padding: 10px;
            overflow-y: scroll;
            background: #f9f9f9;
        }
        .message{
            padding: 5px 10px;
            margin: 3px 0;
            background-color: white;
            border-radius: 8px;
            max-width: 80%;
        }
        form{
            margin-top: 20px;
            display: flex;
            gap: 10px;
        }
        input{
            flex: 1;
            padding: 8px;
        }
        button{
            padding: 8px 15px;
            background: #007bff;
            color: white;
            border: none;
        }
    </style>

</head>

<body>

    <h3>채팅 (WebSocket)</h3>
    <p id="status">서버에 연결하는 중....</p>

    <div class="chat-area" id="chatArea">
    {{#chats}}
        <div class="message">{{msg}}</div>
    {{/chats}}
    </div>

    <form id="chatForm">
        <input type="text" name="msg" id="msg" placeholder="메시지 입력" required autofocus>
        <button type="submit">전송</button>
    </form>

    <script>
        const chatArea = document.getElementById("chatArea")
        const status = document.getElementById("status")
        const chatForm = document.getElementById("chatForm")
        const msgInput = document.getElementById("msg")

        // 받은 메시지를 화면 맨 아래에 추가.
        function appendMessage(msg){
            const div = document.createElement("div")
            div.className = "message"
            div.textContent = msg
            chatArea.appendChild(div)
            chatArea.scrollTop = chatArea.scrollHeight
        }

        // ==================== 웹 소켓 연결 ====================
        // 메시지 규칙 접두사 설정. 서버(ChatWebSocketHandler)에서 설정한 접두사와 똑같이 맞춰줘야함.
        const PREFIX_CHAT = 'CHAT:'
        const PREFIX_MESSAGE = 'MESSAGE:'
        const PREFIX_ERROR = 'ERROR:'

        // 1. 서버에 WebSocket 연결을 연다. (브라우저 내장 객체)
        // tip : 페이지가 "http" 라면 "ws://"으로 시작 , "https" 라면 "wss://"로 시작
        const protocol = location.protocol === "https:" ? "wss://" : "ws://"
        const socket = new WebSocket(protocol + location.host + '/ws-chat')
        console.log("주소확인 : " , protocol + location.host + '/ws-chat')

        // 2. 연결 열렸는지 확인.
        socket.onopen = () => status.textContent = "서버와 연결됨 (WebSocket)"

        // 3. 서버가 메시지를 보내면 접두사를 확인하고 나눔.
        socket.onmessage = e => {
            const text = e.data

            if(text.startsWith(PREFIX_MESSAGE))  appendMessage(text.substring(PREFIX_MESSAGE.length))
            else if(text.startsWith(PREFIX_ERROR))  alert(text.substring(PREFIX_ERROR.length))
            else  console.log("규칙이 없는 메시지 : " , text)
        }

        // 4. 연결이 닫히면 내용 수정.(확인용)
        socket.onclose = e => status.textContent = "연결이 끊겼습니다. 새로고침하면 다시 연결됨."

        // 5. 전송 :
        chatForm.addEventListener("submit" , e => {
            e.preventDefault()
            const msg = msgInput.value.trim()
            if(msg === "") return;

            // 주의) 연결이 열린 상태(open상태) 에서만 보낼 수 있음. 연결 중에 send()를 호출하면 오류.
            if(socket.readyState !== WebSocket.OPEN) {
                alert("서버와 연결되어 있지 않습니다")
                return;
            }

            socket.send(PREFIX_CHAT + msg)
            msgInput.value = ""
            msgInput.focus()
        });

        // 처음 그려진 메시지중 최신 메시지가 보이도록 스크롤을 맨 아래로 내린다.
        chatArea.scrollTop = chatArea.scrollHeight

    </script>
</body>
</html>